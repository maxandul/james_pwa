# At least 32 random characters; never commit a real value.
SECRET_KEY=
# Local development only; Postgres is the deployment target.
DATABASE_URL=sqlite:///james.db
# Railway: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
APP_ENV=development
# Required for invitation links; set to your HTTPS origin before deployment.
PUBLIC_BASE_URL=http://127.0.0.1:5067
# Development uses the public Open Food Facts staging catalogue; production is opt-in via deployment config.
OPENFOODFACTS_ENVIRONMENT=staging
# Identify the application; use a maintainer contact for a public deployment.
OPENFOODFACTS_USER_AGENT=JamesPWA/0.1 (+https://github.com/maxandul/james_pwa)

# JayJay is disabled until credentials, model access and a live connection test are approved.
JAYJAY_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=

# Disabled queued household sign-in pilot; only an explicit consent POST queues work.
SHOP_LOGIN_PILOT_ENABLED=0

# Single household pilot: binding on web and worker; credentials on worker ONLY.
# Use the actual database household ID, never a guessed/default ID.
GALAXUS_HOUSEHOLD_ID=
GALAXUS_EMAIL=
GALAXUS_PASSWORD=

# Separate cart pilot: enable worker first, then expose in web after readiness.
SHOP_CART_PILOT_ENABLED=0
